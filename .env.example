# The public address every printed QR code points at. PERMANENT once cards are
# printed — set it to the real domain before printing /print/genesis.
NEXT_PUBLIC_SITE_URL=https://ripple.cards

# Storage for recorded moments (the Ripple Supabase project; schema lives in
# supabase/migrations/). The key is the project's PUBLISHABLE key — public by
# design. Without these the scan page says "we're still setting up".
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only salt for the daily-rotating session hash used in funnel events.
RIPPLE_SESSION_SALT=

# Story review page (/review).
# RIPPLE_REVIEW_PASSWORD is what a person types to open the queue: at least
# 12 characters, chosen by the owner, set in Vercel (never committed).
# RIPPLE_REVIEW_TOKEN is a long random value this server sends to the
# database; the database stores only its SHA-256 hash in
# private.review_tokens. To rotate: generate a new value, insert its hash,
# update the env var, redeploy, then delete the old hash row.
RIPPLE_REVIEW_PASSWORD=
RIPPLE_REVIEW_TOKEN=
