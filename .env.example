# The public address every printed QR code points at. PERMANENT once cards are
# printed — set it to the real domain before printing /print/genesis.
NEXT_PUBLIC_SITE_URL=https://YOUR-DOMAIN-HERE.example

# Storage for recorded moments. Leave unset until the Supabase project exists
# and docs/supabase-schema-draft.sql has been reviewed and applied; without
# these the scan page says "we're still setting up" instead of saving.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only salt for the daily-rotating session hash used in funnel events.
RIPPLE_SESSION_SALT=
