# The public address every printed QR code points at. PERMANENT once cards are
# printed — set it to the real domain before printing /print/genesis.
NEXT_PUBLIC_SITE_URL=https://ripple.cards

# Storage for recorded moments (the Ripple Supabase project; schema lives in
# supabase/migrations/). The key is the project's PUBLISHABLE key — public by
# design. Without these the scan page says "we're still setting up".
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only salt for the daily-rotating session hash used in funnel events.
RIPPLE_SESSION_SALT=
